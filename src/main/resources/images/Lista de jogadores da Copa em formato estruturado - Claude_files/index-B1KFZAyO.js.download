description:t.jsx(cA,{defaultMessage:"Claude's installation appears to be corrupted. Reinstall Claude from claude.com/download to use this feature.",id:"oqcioCyuAP"})};default:return null}}(e,s);if(!n)return null;const{title:a,description:i}=n;return t.jsx("div",{role:"status",className:"bg-bg-200 border-0.5 border-border-400 rounded-xl p-4 w-full max-w-2xl mx-auto mb-3",children:t.jsxs("div",{className:"flex items-start gap-3",children:[t.jsx("div",{className:"flex items-center justify-center pl-1.5 pt-0.5",children:t.jsx(LO,{className:"w-5 h-5 text-text-300 shrink-0",weight:"fill"})}),t.jsxs("div",{className:"flex flex-col gap-1",children:[t.jsx("span",{className:"text-sm font-medium text-text-000",children:a}),t.jsx("span",{className:"text-sm text-text-200",children:i})]})]})})});const TBt=s(eN());var ABt,RBt;const OBt=s(function(){if(RBt)return ABt;RBt=1;const e=tN();return ABt=(t,s,n)=>e(s,t,n)}()),DBt={releases:[{version:"1.12603.1",date:"2026-06-11",entries:[{surface:"general",kind:"feat",text:"Added Find Next and Find Previous keyboard shortcuts to in-app search."},{surface:"general",kind:"fix",text:"Fixed preview panes stealing keyboard focus from the chat input when they reloaded or navigated."},{surface:"general",kind:"fix",text:"Fixed sessions failing to start after your sign-in expired \u2014 the app now prompts you to sign in again."},{surface:"code",kind:"feat",text:"Added the Files panel to remote and SSH sessions \u2014 search the session's files and open them in the viewer \u2014 plus a Show in Files button in the file viewer."},{surface:"code",kind:"feat",text:"Added a running-tasks button to the activity indicator that opens the Tasks panel, and Bash rows in the Background tasks panel now open to show their output, including a live tail while the command runs."},{surface:"code",kind:"fix",text:'Fixed SSH sessions: forking no longer opens an empty conversation, and connections no longer fail with "Failed to upload file" errors on remotes first set up by early-2026 versions of the app.'},{surface:"code",kind:"fix",text:"Fixed renaming a session while its title was still generating \u2014 the generated title no longer overwrites the name you set."},{surface:"code",kind:"fix",text:'Fixed the Pull Requests view showing "No open pull requests" when GitHub isn\'t connected \u2014 it now prompts you to connect.'},{surface:"code",kind:"feat",text:"Added model-picker memory \u2014 the picker now remembers your last model choice."},{surface:"cowork",kind:"fix",text:"Fixed scheduled tasks firing many duplicate runs at once when the computer wakes from sleep."},{surface:"cowork",kind:"fix",text:"Fixed remote sessions re-prompting for access to folders you had already trusted."},{surface:"cowork",kind:"fix",text:"Fixed plugins becoming corrupted when they synced while you switched accounts."},{surface:"3p",kind:"feat",text:"Added the built-in Microsoft 365 connector \u2014 admins can configure it from the Setup window's server presets. Users sign in through their browser, and Claude can search and read Microsoft 365 mail, calendar, OneDrive, and SharePoint. It requests read-only access by default; admins can grant additional read scopes, such as Teams channel messages and meeting transcripts, with the managed server entry's scope setting."},{surface:"3p",kind:"improvement",text:'Deprecated the "sso" value for the inferenceGatewayAuthScheme managed configuration key in favor of inferenceCredentialKind "interactive" \u2014 existing configurations keep working and log a deprecation warning.'},{surface:"3p",kind:"feat",text:"Added the inferenceVertexOAuthLoginHint managed configuration key to pre-fill the Google account chooser when signing in to Vertex AI, so users in organizations federated to a third-party identity provider land on the right account automatically."}]},{version:"1.11847.5",date:"2026-06-09",entries:[{surface:"general",kind:"fix",text:"Fixed Clear Cache and Restart signing you out instead of just clearing caches."},{surface:"general",kind:"fix",text:"Fixed mouse back and forward buttons not navigating on macOS for mice managed by driver software like Logitech Options+, and added trackpad swipe navigation."},{surface:"general",kind:"fix",text:"Fixed organization plugins sometimes failing to open right after app launch, and the plugin directory now offers Install again after an uninstall."},{surface:"general",kind:"fix",text:'Fixed connector, Chrome extension, and plugin toggles in the composer\'s "+" menu not responding when you click directly on the switch.'},{surface:"general",kind:"fix",text:"Fixed an issue where signing in could leave the app unable to start sessions until it was restarted."},{surface:"general",kind:"fix",text:"Fixed shell-exported custom request headers not reaching Claude Code sessions."},{surface:"code",kind:"fix",text:"Fixed Claude losing its coding instructions, file-link formatting, and worktree context after a session resumed from idle."},{surface:"code",kind:"fix",text:"Fixed the preview pane sometimes connecting to an unrelated dev server that was already using the configured port, and it now reopens the dev server you last picked for each project."},{surface:"code",kind:"improvement",text:"Improved responsiveness in Code sessions: smoother streaming of long code blocks, quicker side-panel shortcuts, and less delay opening cloud sessions with many screenshots."},{surface:"code",kind:"fix",text:"Fixed popovers, dialogs, and the rewind picker not appearing \u2014 and typed characters jumping to the end of the composer \u2014 when a Code session is opened in its own window."},{surface:"code",kind:"fix",text:"Fixed the slash-command menu opening behind the side chat panel."},{surface:"code",kind:"fix",text:"Fixed the source-branch picker showing nothing for SSH sessions with worktree enabled."},{surface:"cowork",kind:"feat",text:'Added a "Free Up Cowork Disk Space" option under Help > Troubleshooting, and Cowork now cleans up caches and old temporary files automatically when its workspace disk runs low.'},{surface:"cowork",kind:"improvement",text:"Improved the read/unread toggle on sidebar sessions: it now works on the currently open session, has a larger click target, and shows a tooltip describing what a click will do."},{surface:"3p",kind:"feat",text:"Added support for the Fable model family, and for Mythos where your organization has access."},{surface:"3p",kind:"fix",text:"Fixed sign-in failing with external identity providers that reject the offline_access scope \u2014 admins can now disable the automatic append."}]},{version:"1.11187.4",date:"2026-06-05",entries:[{surface:"general",kind:"fix",text:"Fixed reinstalling Claude on Windows failing after an uninstall when IT had installed it for all users."},{surface:"general",kind:"fix",text:"Fixed the app not starting automatically at login on Windows."},{surface:"general",kind:"feat",text:"Added a banner when an update fails to install, instead of failing silently."},{surface:"general",kind:"fix",text:"Fixed built-in connectors staying disconnected after a crash \u2014 existing sessions now reconnect them automatically, and disconnecting a built-in connector now signs it out and keeps it disconnected across restarts."},{surface:"code",kind:"feat",text:"Added math rendering for inline and block expressions in Claude Code transcripts."},{surface:"code",kind:"feat",text:"Added Ultracode to the effort slider, which selects the highest effort level and turns on dynamic workflows for the session."},{surface:"code",kind:"feat",text:"Added drag-to-reorder and A\u2192Z sorting for projects in the Claude Code sidebar."},{surface:"code",kind:"feat",text:"Added triple-click to select a whole code block, plus right-click menu actions to copy a code block or inline code, in Claude Code transcripts."},{surface:"code",kind:"fix",text:"Fixed resuming Code sessions when the working folder had moved or been deleted \u2014 sessions saved with a ~ path no longer show as missing or re-prompt for trust, and a deleted remote folder now reports clearly and offers a Fork session button instead of retrying in a loop."},{surface:"cowork",kind:"feat",text:"Added a low-disk-space warning before Cowork downloads the files it needs to run."},{surface:"cowork",kind:"feat",text:"Added in-session effort and thinking controls for local Cowork projects."},{surface:"cowork",kind:"improvement",text:"Updated the New project folder picker to default to your Claude data folder (~/Claude/Projects) instead of ~/Documents."},{surface:"cowork",kind:"fix",text:"Fixed Claude reporting that a skill was updated when the change was never saved to your account."},{surface:"cowork",kind:"fix",text:"Fixed the /schedule command in Cowork showing as unavailable."},{surface:"3p",kind:"fix",text:"Fixed managed connectors and SSO sign-in requesting broader OAuth scopes than the administrator configured."},{surface:"3p",kind:"fix",text:"Fixed three Bedrock sign-in and session issues: SSO sign-in failing behind corporate proxies that intercept secure traffic, expired SSO tokens prompting a new sign-in every hour instead of refreshing automatically, and resumed sessions failing on their first message."}]}]}.releases,PBt={code:new Set(["general","code"]),cowork:new Set(["general","cowork"])};function FBt(e){const t=PBt[e],s=new Set(t),n=DBt.map(e=>({version:e.version,date:e.date,items:e.entries.filter(e=>s.has(e.surface)).map(e=>({kind:e.kind,text:e.text}))})).filter(e=>e.items.length>0),a=new Set(DBt.filter(e=>e.entries.some(e=>t.has(e.surface))).map(e=>e.version)),i=new Map(n.map(e=>[e.version,e]));if("cowork"!==e)for(const r of zBt){if(a.has(r.version))continue;const e=i.get(r.version);i.set(r.version,e?{...e,items:[...e.items,...r.items]}:r)}return[...i.values()].filter(e=>Qe(e.version)).sort((e,t)=>OBt(e.version,t.version))}const zBt=[{version:"1.11187.0",date:"2026-06-04",items:[{kind:"improvement",text:dA({defaultMessage:"Click a filename on an Edited or Wrote row t