<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane stylesheets="@../../css/styleCadastrarSelecao.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ControllerEditarUsuario">


    <BorderPane style="-fx-background-color: #0d0d0d;">


        <center>
            <HBox spacing="40" style="-fx-padding: 40;">


                <VBox prefWidth="600" spacing="20" style="-fx-background-color: #121212; -fx-padding: 25; -fx-background-radius: 10;">

                    <Label style="-fx-text-fill: white; -fx-font-size: 24px;" text="Editar Usuário" />

                    <Label style="-fx-text-fill: #aaaaaa;" text="Edite as informações do usuário" />


                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Label styleClass="label" text="Nome" />
                            <TextField fx:id="nomeEdit"  />
                        </VBox>
                        <VBox spacing="5">
                            <Label styleClass="label" text="Função" />
                            <TextField fx:id="funcaoEdit"  />
                        </VBox>
                    </HBox>


                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Label styleClass="label" text="País" />
                            <TextField fx:id="paisEdit"  />
                        </VBox>
                        <VBox spacing="5">
                            <Label styleClass="label" text="Status" />
                            <TextField fx:id="statusEdit"  />
                        </VBox>
                    </HBox>

                    <Separator />


                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Label styleClass="label" text="Senha" />
                            <PasswordField fx:id="senhaEdit"  />
                        </VBox>
                        <VBox spacing="5">
                            <Label styleClass="label" text="Repetir Senha" />
                            <PasswordField fx:id="senha2Edit"  />
                        </VBox>
                    </HBox>


                    <Label fx:id="labelMensagemEdit" wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: #cc0000;" text="" />


                    <HBox spacing="15">
                        <Button styleClass="btn-secondary" text="Cancelar" />
                        <Button styleClass="btn-primary" text="Salvar Usuário" onAction="#editarUsuario" />
                    </HBox>

                </VBox>




            </HBox>
        </center>

    </BorderPane>

</StackPane>
