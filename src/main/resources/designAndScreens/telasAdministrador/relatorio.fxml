<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="810.0" prefWidth="1710.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ControllerRelatorio">
    <children>
        <Group>
            <children>
                <ImageView fitHeight="810.0" fitWidth="1710.0" pickOnBounds="true">
                    <image>
                        <Image url="@../../images/imagem_tela_relatorio.png" />
                    </image>
                </ImageView>
                <Rectangle arcHeight="5.0" arcWidth="5.0" height="100.0" stroke="#ffffff6d" strokeType="INSIDE" width="1710.0" />

                <StackPane layoutX="91.0" layoutY="59.0" prefHeight="150.0" prefWidth="125.0" styleClass="logo_copa26_arredondado" stylesheets="@../../css/style.css">
                    <children>
                        <ImageView fitHeight="122.0" fitWidth="115.0" onMouseClicked="#irPaginaInicial" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../images/copa.jpg" />
                            </image>
                        </ImageView>
                    </children>
                </StackPane>

                <VBox layoutX="272.0" layoutY="40.0" spacing="2.0">
                    <children>
                        <Text fx:id="botaoRelatorio" fill="WHITE" onMouseClicked="#irParaRelatorio" strokeType="OUTSIDE" strokeWidth="0.0" text="Relatórios" textAlignment="CENTER">
                            <font><Font name="Oswald Medium" size="30.0" /></font>
                        </Text>
                        <Line endX="100.0" stroke="WHITE" strokeWidth="2.0" />
                    </children>
                </VBox>

                <Text fill="WHITE" layoutX="437.0" layoutY="64.0" onMouseClicked="#irParaEquipes" strokeType="OUTSIDE" strokeWidth="0.0" text="Equipes" textAlignment="CENTER">
                    <font><Font name="Oswald Medium" size="30.0" /></font>
                </Text>
                <Text fill="WHITE" layoutX="602.0" layoutY="64.0" onMouseClicked="#irParaClassificacao" strokeType="OUTSIDE" strokeWidth="0.0" text="Classificação" textAlignment="CENTER">
                    <font><Font name="Oswald Medium" size="30.0" /></font>
                </Text>
                <Text fill="WHITE" layoutX="807.0" layoutY="64.0" onMouseClicked="#irParaEstadios" strokeType="OUTSIDE" strokeWidth="0.0" text="Estádios" textAlignment="CENTER">
                    <font><Font name="Oswald Medium" size="30.0" /></font>
                </Text>
                <Text fx:id="botaoArbitro" fill="WHITE" layoutX="970" layoutY="63.0" onMouseClicked="#irParaArbitros" strokeType="OUTSIDE" strokeWidth="0.0" text="Árbitros" textAlignment="CENTER">
                    <font><Font name="Oswald Medium" size="30.0" /></font>
                </Text>
                <Text fx:id="botaoUsuario" fill="WHITE" layoutX="1107" layoutY="64.0" onMouseClicked="#irParaUsuarios" strokeType="OUTSIDE" strokeWidth="0.0" text="Usuários" textAlignment="CENTER" visible="false">
                    <font><Font name="Oswald Medium" size="30.0" /></font>
                </Text>

                <Button fx:id="botaoLogin" layoutX="1297.0" layoutY="27.0" mnemonicParsing="false" onAction="#irParaLogin" styleClass="white_button" stylesheets="@../../css/style.css" text="Login">
                    <font><Font name="Oswald Medium" size="12.0" /></font>
                </Button>
                <MenuButton fx:id="menuUsuario" layoutX="1297.0" layoutY="27.0" mnemonicParsing="false" maxWidth="150" prefWidth="150" visible="false" styleClass="white_button" stylesheets="@../../css/style.css">
                    <font><Font name="Oswald Medium" size="12.0" /></font>
                    <items>
                        <MenuItem text="Logout" onAction="#onLogout" />
                        <MenuItem text="Cancelar" />
                    </items>
                </MenuButton>
            </children>
        </Group>


        <VBox layoutX="0.0" layoutY="130.0" prefWidth="1710.0" alignment="TOP_CENTER" spacing="50.0" stylesheets="@../../css/styleRelatorio.css">
            <padding>
                <Insets top="60.0" bottom="60.0" left="80.0" right="80.0" />
            </padding>

            <VBox alignment="CENTER" translateX="-50" spacing="8.0">
                <Text fill="#1a1a1a" text="Gerar Relatórios" textAlignment="CENTER" styleClass="titulo-relatorios">
                    <font><Font name="Oswald Medium" size="42.0" /></font>
                </Text>
                <Text fill="#6b4f10" text="Selecione uma categoria e exporte os dados" textAlignment="CENTER">
                    <font><Font name="Oswald Medium" size="18.0" /></font>
                </Text>
            </VBox>


            <HBox spacing="18.0" alignment="CENTER" translateX="-80.0">


                <VBox styleClass="card-relatorio" alignment="CENTER" spacing="18.0" prefWidth="230.0" prefHeight="280.0" stylesheets="@../../css/styleRelatorio.css">
                    <padding><Insets top="30.0" bottom="30.0" left="20.0" right="20.0" /></padding>
                    <StackPane styleClass="icone-circulo" prefWidth="68.0" prefHeight="68.0">
                        <Text text="🏆" styleClass="icone-emoji" />
                    </StackPane>
                    <VBox alignment="CENTER" spacing="6.0">
                        <Text fill="#0d0d0d" text="Seleções" textAlignment="CENTER" styleClass="card-titulo">
                            <font><Font name="Oswald Medium" size="22.0" /></font>
                        </Text>
                        <Text fill="#888888" text="Todas as seleções&#10;participantes" textAlignment="CENTER" styleClass="card-subtitulo">
                            <font><Font name="Inter 18pt" size="12.0" /></font>
                        </Text>
                    </VBox>
                    <Button styleClass="botao-relatorio" text="Gerar Relatório" onAction="#gerarRelatorioSelecoes" mnemonicParsing="false">
                        <font><Font name="Oswald Medium" size="13.0" /></font>
                    </Button>
                </VBox>


                <VBox styleClass="card-relatorio" alignment="CENTER" spacing="18.0" prefWidth="230.0" prefHeight="280.0" stylesheets="@../../css/styleRelatorio.css">
                    <padding><Insets top="30.0" bottom="30.0" left="20.0" right="20.0" /></padding>
                    <StackPane styleClass="icone-circulo" prefWidth="68.0" prefHeight="68.0">
                        <Text text="⚽" styleClass="icone-emoji" />
                    </StackPane>
                    <VBox alignment="CENTER" spacing="6.0">
                        <Text fill="#0d0d0d" text="Jogadores" textAlignment="CENTER" styleClass="card-titulo">
                            <font><Font name="Oswald Medium" size="22.0" /></font>
                        </Text>
                        <Text fill="#888888" text="Lista completa&#10;de atletas" textAlignment="CENTER" styleClass="card-subtitulo">
                            <font><Font name="Inter 18pt" size="12.0" /></font>
                        </Text>
                    </VBox>
                    <Button styleClass="botao-relatorio" text="Gerar Relatório" onAction="#gerarRelatorioJogadores" mnemonicParsing="false">
                        <font><Font name="Oswald Medium" size="13.0" /></font>
                    </Button>
                </VBox>


                <VBox styleClass="card-relatorio" alignment="CENTER" spacing="18.0" prefWidth="230.0" prefHeight="280.0" stylesheets="@../../css/styleRelatorio.css">
                    <padding><Insets top="30.0" bottom="30.0" left="20.0" right="20.0" /></padding>
                    <StackPane styleClass="icone-circulo" prefWidth="68.0" prefHeight="68.0">
                        <Text text="🟨" styleClass="icone-emoji" />
                    </StackPane>
                    <VBox alignment="CENTER" spacing="6.0">
                        <Text fill="#0d0d0d" text="Árbitros" textAlignment="CENTER" styleClass="card-titulo">
                            <font><Font name="Oswald Medium" size="22.0" /></font>
                        </Text>
                        <Text fill="#888888" text="Árbitros escalados&#10;no torneio" textAlignment="CENTER" styleClass="card-subtitulo">
                            <font><Font name="Inter 18pt" size="12.0" /></font>
                        </Text>
                    </VBox>
                    <Button styleClass="botao-relatorio" text="Gerar Relatório" onAction="#gerarRelatorioArbitros" mnemonicParsing="false">
                        <font><Font name="Oswald Medium" size="13.0" /></font>
                    </Button>
                </VBox>


                <VBox styleClass="card-relatorio" alignment="CENTER" spacing="18.0" prefWidth="230.0" prefHeight="280.0" stylesheets="@../../css/styleRelatorio.css">
                    <padding><Insets top="30.0" bottom="30.0" left="20.0" right="20.0" /></padding>
                    <StackPane styleClass="icone-circulo" prefWidth="68.0" prefHeight="68.0">
                        <Text text="🏟️" styleClass="icone-emoji" />
                    </StackPane>
                    <VBox alignment="CENTER" spacing="6.0">
                        <Text fill="#0d0d0d" text="Estádios" textAlignment="CENTER" styleClass="card-titulo">
                            <font><Font name="Oswald Medium" size="22.0" /></font>
                        </Text>
                        <Text fill="#888888" text="Estádios sedes&#10;da competição" textAlignment="CENTER" styleClass="card-subtitulo">
                            <font><Font name="Inter 18pt" size="12.0" /></font>
                        </Text>
                    </VBox>
                    <Button styleClass="botao-relatorio" text="Gerar Relatório" onAction="#gerarRelatorioEstadios" mnemonicParsing="false">
                        <font><Font name="Oswald Medium" size="13.0" /></font>
                    </Button>
                </VBox>


                <VBox styleClass="card-relatorio" alignment="CENTER" spacing="18.0" prefWidth="230.0" prefHeight="280.0" stylesheets="@../../css/styleRelatorio.css">
                    <padding><Insets top="30.0" bottom="30.0" left="20.0" right="20.0" /></padding>
                    <StackPane styleClass="icone-circulo" prefWidth="68.0" prefHeight="68.0">
                        <Text text="👤" styleClass="icone-emoji" />
                    </StackPane>
                    <VBox alignment="CENTER" spacing="6.0">
                        <Text fill="#0d0d0d" text="Usuários" textAlignment="CENTER" styleClass="card-titulo">
                            <font><Font name="Oswald Medium" size="22.0" /></font>
                        </Text>
                        <Text fill="#888888" text="Usuários cadastrados&#10;no sistema" textAlignment="CENTER" styleClass="card-subtitulo">
                            <font><Font name="Inter 18pt" size="12.0" /></font>
                        </Text>
                    </VBox>
                    <Button styleClass="botao-relatorio" text="Gerar Relatório" onAction="#gerarRelatorioUsuarios" mnemonicParsing="false">
                        <font><Font name="Oswald Medium" size="13.0" /></font>
                    </Button>
                </VBox>

            </HBox>
        </VBox>

    </children>
</AnchorPane>
